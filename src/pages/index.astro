---
import AppLayout from '../layouts/AppLayout.astro';
import { LandingSearchIsland } from '../components/islands/LandingSearchIsland';
import { WireframeGlobeIsland } from '../components/islands/WireframeGlobeIsland';
---

<AppLayout title="Tasmania Aerial Photo Explorer">
  <div
    class="landing-page relative h-[calc(100dvh-var(--mobile-nav-height,0px))] max-h-[calc(100dvh-var(--mobile-nav-height,0px))] overflow-hidden bg-slate-100 text-slate-950 dark:bg-slate-950 dark:text-white"
  >
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div
        class="absolute top-[6%] right-[-16%] h-[min(108vw,760px)] w-[min(108vw,760px)] max-sm:top-[14%] max-sm:right-[-30%] max-sm:h-[128vw] max-sm:w-[128vw]"
      >
        <WireframeGlobeIsland client:only="react" />
      </div>
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(248,250,252,0.94)_0%,rgba(248,250,252,0.78)_38%,rgba(248,250,252,0.4)_68%,rgba(248,250,252,0.08)_100%)] dark:bg-[linear-gradient(90deg,rgba(2,6,23,0.94)_0%,rgba(2,6,23,0.78)_38%,rgba(2,6,23,0.35)_68%,rgba(2,6,23,0.08)_100%)]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_14%_12%,rgba(249,115,22,0.12),transparent_32%),radial-gradient(circle_at_78%_88%,rgba(14,165,233,0.12),transparent_36%)] dark:bg-[radial-gradient(circle_at_14%_12%,rgba(249,115,22,0.22),transparent_32%),radial-gradient(circle_at_78%_88%,rgba(220,38,38,0.18),transparent_36%)]"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(15,23,42,0.045)_1px,transparent_1px),linear-gradient(90deg,rgba(15,23,42,0.045)_1px,transparent_1px)] bg-[size:72px_72px] opacity-35 dark:bg-[linear-gradient(rgba(251,146,60,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(251,146,60,0.04)_1px,transparent_1px)] dark:opacity-40"
    >
    </div>

    <main
      class="relative z-1 flex h-full min-h-0 flex-col overflow-hidden px-4 pt-4 pb-4 sm:px-7 sm:py-7 lg:pl-14"
    >
      <header class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-950 text-sm font-black text-white shadow-[0_14px_34px_rgba(15,23,42,0.2)] ring-1 ring-white/40 dark:bg-orange-500 dark:text-slate-950 dark:shadow-[0_14px_34px_rgba(249,115,22,0.35)] dark:ring-orange-200/40"
          >
            TAS
          </div>
          <div>
            <p class="text-sm font-bold tracking-wide">Aerial Photo Explorer</p>
            <p class="text-xs text-slate-600 dark:text-orange-100/55">LIST Tasmania archive</p>
          </div>
        </div>
        <a
          href="/search"
          data-astro-prefetch
          class="hidden rounded-full border border-slate-950/10 bg-white/70 px-4 py-2 text-sm font-bold text-slate-700 backdrop-blur-md transition hover:border-orange-500/35 hover:bg-white hover:text-slate-950 sm:inline-flex dark:border-orange-500/25 dark:bg-slate-950/50 dark:text-orange-50/90 dark:hover:border-orange-400/45 dark:hover:bg-slate-950/70 dark:hover:text-white"
        >
          Open map
        </a>
      </header>

      <section
        class="grid min-h-0 flex-1 items-center gap-4 py-4 sm:gap-8 sm:py-10 lg:grid-cols-[minmax(0,0.95fr)_25rem]"
      >
        <div class="max-w-4xl">
          <div
            class="mb-3 inline-flex items-center gap-2 rounded-full border border-slate-950/10 bg-white/60 px-3 py-1.5 text-xs font-black tracking-wider text-slate-700 uppercase backdrop-blur-md sm:mb-5 dark:border-orange-500/25 dark:bg-slate-950/45 dark:text-orange-100/85"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-orange-500"></span>
            Historical imagery from 1946
          </div>

          <h1
            class="max-w-4xl text-[clamp(3rem,15vw,8.4rem)] leading-[0.88] font-black tracking-normal text-balance sm:text-[clamp(3.35rem,8.5vw,8.4rem)]"
          >
            Search Tasmania from above.
          </h1>

          <p
            class="mt-3 max-w-2xl text-base leading-7 font-medium text-slate-600 sm:mt-6 sm:text-xl sm:leading-8 dark:text-orange-50/72"
          >
            Find a place, scan the mapped footprints, and open archive aerial, orthophoto, or
            digital imagery without fighting the map.
          </p>

          <div
            class="mt-4 max-w-2xl rounded-[1.35rem] border border-slate-950/10 bg-white/78 p-2 shadow-[0_24px_70px_rgba(15,23,42,0.14)] backdrop-blur-xl sm:mt-8 dark:border-orange-500/20 dark:bg-slate-950/55 dark:shadow-[0_24px_70px_rgba(0,0,0,0.45)]"
          >
            <LandingSearchIsland client:only="react" />
          </div>

          <div
            class="mt-3 flex flex-wrap gap-2 text-sm font-semibold text-slate-600 sm:mt-6 dark:text-orange-50/75"
          >
            <a
              href="/search?q=Hobart&lat=-42.8821&lon=147.3272"
              data-astro-prefetch
              class="rounded-full border border-slate-950/8 bg-white/64 px-3 py-2 shadow-sm transition hover:border-orange-500/25 hover:bg-white hover:text-slate-950 dark:border-orange-500/18 dark:bg-slate-950/40 dark:hover:border-orange-400/35 dark:hover:bg-slate-950/65 dark:hover:text-white"
            >
              Hobart
            </a>
            <a
              href="/search?q=Launceston&lat=-41.4332&lon=147.1441"
              data-astro-prefetch
              class="rounded-full border border-slate-950/8 bg-white/64 px-3 py-2 shadow-sm transition hover:border-orange-500/25 hover:bg-white hover:text-slate-950 dark:border-orange-500/18 dark:bg-slate-950/40 dark:hover:border-orange-400/35 dark:hover:bg-slate-950/65 dark:hover:text-white"
            >
              Launceston
            </a>
            <a
              href="/search?q=Port%20Arthur&lat=-43.1470&lon=147.8510"
              data-astro-prefetch
              class="rounded-full border border-slate-950/8 bg-white/64 px-3 py-2 shadow-sm transition hover:border-orange-500/25 hover:bg-white hover:text-slate-950 dark:border-orange-500/18 dark:bg-slate-950/40 dark:hover:border-orange-400/35 dark:hover:bg-slate-950/65 dark:hover:text-white"
            >
              Port Arthur
            </a>
          </div>
        </div>

        <aside class="hidden flex-col gap-3 lg:flex">
          <div
            class="rounded-[1.25rem] border border-slate-950/10 bg-white/62 p-5 shadow-[0_18px_44px_rgba(15,23,42,0.1)] backdrop-blur-xl dark:border-orange-500/18 dark:bg-slate-950/50 dark:shadow-[0_18px_44px_rgba(0,0,0,0.35)]"
          >
            <p
              class="text-xs font-black tracking-wider text-slate-500 uppercase dark:text-orange-200/55"
            >
              Coverage
            </p>
            <p class="mt-2 text-4xl font-black">3 layers</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-orange-50/62">
              Aerial, orthophoto, and digital layers.
            </p>
          </div>
          <div
            class="rounded-[1.25rem] border border-slate-950/10 bg-white/62 p-5 shadow-[0_18px_44px_rgba(15,23,42,0.1)] backdrop-blur-xl dark:border-orange-500/18 dark:bg-slate-950/50 dark:shadow-[0_18px_44px_rgba(0,0,0,0.35)]"
          >
            <p
              class="text-xs font-black tracking-wider text-slate-500 uppercase dark:text-orange-200/55"
            >
              Workflow
            </p>
            <p class="mt-2 text-4xl font-black">Map-first</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-orange-50/62">
              Search, scan footprints, preview, then open full resolution.
            </p>
          </div>
          <div
            class="rounded-[1.25rem] border border-orange-500/22 bg-orange-400/13 p-5 shadow-[0_18px_44px_rgba(15,23,42,0.1)] backdrop-blur-xl dark:border-red-500/22 dark:bg-orange-500/12 dark:shadow-[0_18px_44px_rgba(0,0,0,0.35)]"
          >
            <p
              class="text-xs font-black tracking-wider text-orange-700 uppercase dark:text-orange-200/70"
            >
              AI assist
            </p>
            <p class="mt-2 text-4xl font-black">Natural</p>
            <p class="mt-1 text-sm text-slate-600 dark:text-orange-50/70">
              Ask for places, periods, and imagery type in plain English.
            </p>
          </div>
        </aside>
      </section>

      <footer
        class="relative z-1 grid shrink-0 gap-1.5 border-t border-slate-950/10 pt-2.5 text-sm text-slate-500 sm:grid-cols-3 sm:gap-3 sm:pt-4 dark:border-orange-500/15 dark:text-orange-100/55"
      >
        <div>
          <span class="font-black text-slate-950 dark:text-white">1946+</span>
          <span class="ml-2">historical photo archive</span>
        </div>
        <div>
          <span class="font-black text-slate-950 dark:text-white">Footprints</span>
          <span class="ml-2">mapped for quick inspection</span>
        </div>
        <div>
          <span class="font-black text-slate-950 dark:text-white">Workers</span>
          <span class="ml-2">proxied and cached imagery</span>
        </div>
      </footer>
    </main>
  </div>
</AppLayout>
