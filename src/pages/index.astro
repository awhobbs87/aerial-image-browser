---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Tasmania Aerial Photo Explorer">
  <main>
    <div class="hero">
      <h1>Tasmania Aerial Photo Explorer</h1>
      <p>Browse historical, orthophoto, and digital aerial imagery of Tasmania.</p>
    </div>
  </main>
</AppLayout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 1rem;
  }

  .hero {
    text-align: center;
    max-width: 600px;
  }

  .hero h1 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .hero p {
    font-size: clamp(1rem, 2vw, 1.25rem);
    opacity: 0.7;
  }
</style>
