---
import AppLayout from '../layouts/AppLayout.astro';
import { LandingSearchIsland } from '../components/islands/LandingSearchIsland';
import { WireframeGlobeIsland } from '../components/islands/WireframeGlobeIsland';
---

<AppLayout title="Tasmania Aerial Photo Explorer">
  <div
    class="landing-page relative h-[calc(100dvh-var(--mobile-nav-height,0px))] max-h-[calc(100dvh-var(--mobile-nav-height,0px))] overflow-hidden bg-slate-100 text-slate-950 dark:bg-slate-950 dark:text-white"
  >
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div
        class="absolute top-[8.5rem] right-[-34%] h-[118vw] w-[118vw] opacity-70 sm:top-[6%] sm:right-[-16%] sm:h-[min(108vw,760px)] sm:w-[min(108vw,760px)] sm:opacity-100"
      >
        <WireframeGlobeIsland client:only="react" />
      </div>
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(248,250,252,0.94)_0%,rgba(248,250,252,0.78)_38%,rgba(248,250,252,0.4)_68%,rgba(248,250,252,0.08)_100%)] dark:bg-[linear-gradient(90deg,rgba(2,6,23,0.94)_0%,rgba(2,6,23,0.78)_38%,rgba(2,6,23,0.35)_68%,rgba(2,6,23,0.08)_100%)]"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(15,23,42,0.045)_1px,transparent_1px),linear-gradient(90deg,rgba(15,23,42,0.045)_1px,transparent_1px)] bg-[size:72px_72px] opacity-35 dark:bg-[linear-gradient(rgba(251,146,60,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(251,146,60,0.04)_1px,transparent_1px)] dark:opacity-40"
    >
    </div>

    <main
      class="relative z-1 flex h-full min-h-0 flex-col overflow-hidden px-4 pt-4 pb-3 sm:px-7 sm:py-7 lg:pl-14"
    >
      <header class="flex shrink-0 items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-950 text-xs font-black text-white shadow-[0_10px_26px_rgba(15,23,42,0.18)] ring-1 ring-white/40 sm:h-10 sm:w-10 sm:text-sm dark:bg-orange-500 dark:text-slate-950 dark:shadow-[0_10px_26px_rgba(249,115,22,0.3)] dark:ring-orange-200/40"
          >
            TAS
          </div>
          <div>
            <p class="text-sm leading-tight font-bold tracking-wide">Aerial Photo Explorer</p>
            <p class="text-xs text-slate-600 dark:text-orange-100/55">LIST Tasmania archive</p>
          </div>
        </div>
        <a
          href="/search"
          data-astro-prefetch
          class="hidden rounded-full border border-slate-950/10 bg-white/70 px-4 py-2 text-sm font-bold text-slate-700 backdrop-blur-md transition hover:border-orange-500/35 hover:bg-white hover:text-slate-950 sm:inline-flex dark:border-orange-500/25 dark:bg-slate-950/50 dark:text-orange-50/90 dark:hover:border-orange-400/45 dark:hover:bg-slate-950/70 dark:hover:text-white"
        >
          Open map
        </a>
      </header>

      <section
        class="grid min-h-0 shrink-0 gap-3 pt-5 pb-3 sm:flex-1 sm:items-center sm:gap-8 sm:py-10 lg:grid-cols-[minmax(0,0.95fr)_25rem]"
      >
        <div class="max-w-4xl">
          <div
            class="mb-3 inline-flex items-center gap-2 rounded-full border border-slate-950/10 bg-white/72 px-3 py-1.5 text-[0.68rem] font-black tracking-wider text-slate-700 uppercase backdrop-blur-md sm:mb-5 sm:text-xs dark:border-orange-500/25 dark:bg-slate-950/45 dark:text-orange-100/85"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-orange-500"></span>
            Historical imagery from 1946
          </div>

          <h1
            class="max-w-4xl text-[clamp(2.55rem,12vw,4rem)] leading-[0.93] font-black tracking-normal text-balance sm:text-[clamp(3.35rem,7.2vw,7rem)] sm:leading-[0.9]"
          >
            Search Tasmania from above.
          </h1>

          <p
            class="mt-3 max-w-[31rem] text-sm leading-6 font-medium text-slate-600 sm:mt-6 sm:max-w-2xl sm:text-xl sm:leading-8 dark:text-orange-50/72"
          >
            Find a place, scan the mapped footprints, and open archive aerial, orthophoto, or
            digital imagery without fighting the map.
          </p>

          <div
            class="mt-4 max-w-2xl rounded-xl border border-slate-950/10 bg-white/84 p-1.5 shadow-[0_18px_46px_rgba(15,23,42,0.1)] backdrop-blur-xl sm:mt-8 sm:p-2 dark:border-orange-500/20 dark:bg-slate-950/60 dark:shadow-[0_20px_54px_rgba(0,0,0,0.38)]"
          >
            <LandingSearchIsland client:only="react" />
          </div>

          <div
            class="mt-3 flex gap-2 overflow-x-auto pb-1 text-sm font-semibold text-slate-600 [-ms-overflow-style:none] [scrollbar-width:none] sm:mt-6 sm:flex-wrap sm:overflow-visible sm:pb-0 dark:text-orange-50/75 [&::-webkit-scrollbar]:hidden"
          >
            <a
              href="/search?q=Hobart&lat=-42.8821&lon=147.3272"
              data-astro-prefetch
              class="shrink-0 rounded-full border border-slate-950/8 bg-white/70 px-3 py-2 shadow-sm transition hover:border-orange-500/25 hover:bg-white hover:text-slate-950 dark:border-orange-500/18 dark:bg-slate-950/40 dark:hover:border-orange-400/35 dark:hover:bg-slate-950/65 dark:hover:text-white"
            >
              Hobart
            </a>
            <a
              href="/search?q=Launceston&lat=-41.4332&lon=147.1441"
              data-astro-prefetch
              class="shrink-0 rounded-full border border-slate-950/8 bg-white/70 px-3 py-2 shadow-sm transition hover:border-orange-500/25 hover:bg-white hover:text-slate-950 dark:border-orange-500/18 dark:bg-slate-950/40 dark:hover:border-orange-400/35 dark:hover:bg-slate-950/65 dark:hover:text-white"
            >
              Launceston
            </a>
            <a
              href="/search?q=Port%20Arthur&lat=-43.1470&lon=147.8510"
              data-astro-prefetch
              class="shrink-0 rounded-full border border-slate-950/8 bg-white/70 px-3 py-2 shadow-sm transition hover:border-orange-500/25 hover:bg-white hover:text-slate-950 dark:border-orange-500/18 dark:bg-slate-950/40 dark:hover:border-orange-400/35 dark:hover:bg-slate-950/65 dark:hover:text-white"
            >
              Port Arthur
            </a>
          </div>
        </div>

        <aside class="hidden flex-col gap-3 lg:flex">
          <div
            class="rounded-lg border border-slate-950/10 bg-white/64 p-5 shadow-[0_16px_38px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-orange-500/18 dark:bg-slate-950/54 dark:shadow-[0_16px_38px_rgba(0,0,0,0.3)]"
          >
            <p
              class="text-xs font-black tracking-wider text-slate-500 uppercase dark:text-orange-200/55"
            >
              Coverage
            </p>
            <p class="mt-2 text-4xl font-black">3 layers</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-orange-50/62">
              Aerial, orthophoto, and digital layers.
            </p>
          </div>
          <div
            class="rounded-lg border border-slate-950/10 bg-white/64 p-5 shadow-[0_16px_38px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-orange-500/18 dark:bg-slate-950/54 dark:shadow-[0_16px_38px_rgba(0,0,0,0.3)]"
          >
            <p
              class="text-xs font-black tracking-wider text-slate-500 uppercase dark:text-orange-200/55"
            >
              Workflow
            </p>
            <p class="mt-2 text-4xl font-black">Map-first</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-orange-50/62">
              Search, scan footprints, preview, then open full resolution.
            </p>
          </div>
          <div
            class="rounded-lg border border-orange-500/22 bg-orange-400/12 p-5 shadow-[0_16px_38px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-red-500/22 dark:bg-orange-500/12 dark:shadow-[0_16px_38px_rgba(0,0,0,0.3)]"
          >
            <p
              class="text-xs font-black tracking-wider text-orange-700 uppercase dark:text-orange-200/70"
            >
              AI assist
            </p>
            <p class="mt-2 text-4xl font-black">Natural</p>
            <p class="mt-1 text-sm text-slate-600 dark:text-orange-50/70">
              Ask for places, periods, and imagery type in plain English.
            </p>
          </div>
        </aside>
      </section>

      <footer
        class="relative z-1 mt-auto grid shrink-0 grid-cols-3 gap-1.5 border-t border-slate-950/10 pt-2.5 text-xs text-slate-500 sm:grid-cols-3 sm:gap-3 sm:pt-4 sm:text-sm dark:border-orange-500/15 dark:text-orange-100/55"
      >
        <div class="min-w-0">
          <span class="block font-black text-slate-950 dark:text-white">1946+</span>
          <span class="block truncate sm:ml-2 sm:inline">photo archive</span>
        </div>
        <div class="min-w-0">
          <span class="block font-black text-slate-950 dark:text-white">Footprints</span>
          <span class="block truncate sm:ml-2 sm:inline">mapped</span>
        </div>
        <div class="min-w-0">
          <span class="block font-black text-slate-950 dark:text-white">Workers</span>
          <span class="block truncate sm:ml-2 sm:inline">cached imagery</span>
        </div>
      </footer>
    </main>
  </div>
</AppLayout>
