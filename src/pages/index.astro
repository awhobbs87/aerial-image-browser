---
import { ApertureIcon, ArrowUpRightIcon, MapPinIcon } from '@phosphor-icons/react';
import AppLayout from '../layouts/AppLayout.astro';
import { LandingSearchIsland } from '../components/islands/LandingSearchIsland';
import { KumoGlobeIsland } from '../components/islands/KumoGlobeIsland';

const places = [
  { name: 'Hobart', lat: -42.8821, lon: 147.3272 },
  { name: 'Launceston', lat: -41.4332, lon: 147.1441 },
  { name: 'Port Arthur', lat: -43.147, lon: 147.851 },
];
---

<AppLayout
  title="Tasmania Aerial Photo Explorer"
  description="Explore Tasmania through historical aerial photography from 1946 onwards. Search a place or address to find images in the LIST Tasmania archive."
>
  <div
    class="landing-page relative isolate h-[calc(100dvh-var(--mobile-nav-height,0px))] overflow-hidden bg-stone-50 text-stone-950 dark:bg-stone-950 dark:text-stone-50"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 overflow-hidden [container-type:size]"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_at_68%_48%,rgba(251,146,60,0.12),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_68%_48%,rgba(234,88,12,0.16),transparent_62%)]"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle,currentColor_0.7px,transparent_0.7px)] bg-size-[24px_24px] text-stone-900/10 dark:text-stone-100/12"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 size-[min(96cqw,88cqh,56rem)] -translate-x-1/2 -translate-y-1/2 opacity-65 md:left-[62%] md:size-[min(74cqw,94cqh,62rem)] md:opacity-100"
      >
        <KumoGlobeIsland client:only="react" />
      </div>
      <div
        class="absolute inset-0 bg-linear-to-b from-stone-50/10 via-stone-50/50 to-stone-50/15 md:bg-linear-to-r md:from-stone-50/85 md:via-stone-50/40 md:to-transparent dark:from-stone-950/10 dark:via-stone-950/60 dark:to-stone-950/20 md:dark:from-stone-950/90 md:dark:via-stone-950/45 md:dark:to-transparent"
      >
      </div>
    </div>

    <div class="h-full overflow-y-auto overscroll-contain">
      <div
        class="mx-auto flex min-h-full max-w-[100rem] flex-col px-5 pt-4 pb-4 sm:px-8 sm:py-6 lg:px-[clamp(2.5rem,5vw,6rem)]"
      >
        <header class="flex items-center justify-between gap-3">
          <div class="flex min-w-0 items-center gap-2.5">
            <span
              class="grid size-9 shrink-0 place-items-center rounded-xl bg-stone-900 text-orange-200 dark:bg-orange-300 dark:text-stone-950"
            >
              <ApertureIcon size={22} aria-hidden="true" />
            </span>
            <p class="text-sm leading-tight font-semibold tracking-tight">Aerial Photo Explorer</p>
          </div>
          <a
            href="/search"
            data-astro-prefetch
            class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-lg border border-stone-900/12 bg-white/35 px-2.5 text-xs font-semibold whitespace-nowrap backdrop-blur-[1px] transition-colors hover:border-orange-600/40 hover:bg-white/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600 sm:px-3 sm:text-sm dark:border-white/15 dark:bg-stone-950/30 dark:hover:border-orange-300/45 dark:hover:bg-stone-900/75 dark:focus-visible:outline-orange-300"
          >
            Open map
            <ArrowUpRightIcon size={15} aria-hidden="true" />
          </a>
        </header>

        <section aria-labelledby="landing-title" class="my-auto max-w-[42rem] py-7 sm:py-10">
          <h1
            id="landing-title"
            class="text-[clamp(2.75rem,8.8vw,4.5rem)] leading-[0.98] font-semibold tracking-[-0.065em] sm:text-[clamp(3.5rem,6vw,6.5rem)]"
          >
            Search Tasmania
            <span class="block text-orange-800 dark:text-orange-300">from above.</span>
          </h1>

          <p
            class="mt-4 max-w-[39ch] text-pretty text-base leading-relaxed text-stone-700 sm:mt-5 sm:text-lg dark:text-stone-300"
          >
            See how places have changed through aerial photos from 1946 to today.
          </p>

          <div class="mt-6 max-w-xl sm:mt-8">
            <label
              for="landing-location-search"
              class="mb-2 block text-sm font-semibold text-stone-800 dark:text-stone-100"
            >
              Find a place or address
            </label>
            <LandingSearchIsland client:load />
            <nav aria-label="Popular locations" class="mt-3 flex flex-wrap gap-x-2 gap-y-1">
              {
                places.map(({ name, lat, lon }) => (
                  <a
                    href={`/search?${new URLSearchParams({ q: name, lat: String(lat), lon: String(lon) })}`}
                    data-astro-prefetch
                    class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-stone-900/10 bg-white/35 px-3 text-xs font-semibold text-stone-700 backdrop-blur-[1px] transition-colors hover:border-orange-600/40 hover:bg-white/75 hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600 sm:text-sm dark:border-white/15 dark:bg-stone-950/25 dark:text-stone-200 dark:hover:border-orange-300/45 dark:hover:bg-stone-900/75 dark:focus-visible:outline-orange-300"
                  >
                    <MapPinIcon size={14} aria-hidden="true" />
                    {name}
                  </a>
                ))
              }
            </nav>
          </div>
        </section>

        <footer
          class="border-t border-stone-900/10 pt-3 text-xs text-stone-600 dark:border-white/12 dark:text-stone-400"
        >
          Imagery from the LIST Tasmania archive
        </footer>
      </div>
    </div>
  </div>
</AppLayout>
