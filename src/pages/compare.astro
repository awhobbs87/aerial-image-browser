---
import AppLayout from '../layouts/AppLayout.astro';
import { NavigationIsland } from '../components/islands/NavigationIsland';
import { MobileNavIsland } from '../components/islands/MobileNavIsland';
---

<AppLayout title="Compare - Tasmania Aerial Photo Explorer">
  <!-- Desktop sidebar navigation -->
  <NavigationIsland client:only="react" />

  <div class="compare-page">
    <div class="compare-header">
      <h1>Compare Photos</h1>
      <p>Select two photos to compare side by side, with a slider, or then vs now.</p>
    </div>
    <div class="compare-content" id="compare-island">
      <p class="placeholder">Select photos from search results to compare them here.</p>
    </div>
  </div>

  <!-- Mobile bottom tab bar -->
  <MobileNavIsland client:only="react" />
</AppLayout>

<style>
  .compare-page {
    min-height: 100vh;
    padding: 1rem;
  }

  @media (min-width: 48em) {
    .compare-page {
      padding-left: 2rem;
      padding-right: 2rem;
      max-width: 1200px;
    }
  }

  .compare-header {
    margin-bottom: 2rem;
    padding-top: 1rem;
  }

  .compare-header h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .compare-header p {
    opacity: 0.6;
  }

  .placeholder {
    text-align: center;
    opacity: 0.5;
    padding: 3rem 1rem;
  }
</style>
