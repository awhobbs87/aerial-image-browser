---
import AppLayout from '../layouts/AppLayout.astro';
import { FavoritesIsland } from '../components/islands/FavoritesIsland';
---

<AppLayout title="Favorites - Tasmania Aerial Photo Explorer">
  <div class="app-page min-h-[calc(100dvh-var(--mobile-nav-height,0px))]">
    <div class="app-page-header">
      <div>
        <p class="app-eyebrow mb-2">Your archive</p>
        <h1 class="text-3xl font-bold text-slate-950 sm:text-4xl dark:text-white">Saved photos</h1>
        <p class="mt-2 text-sm text-slate-500 sm:text-base dark:text-slate-400">
          A personal collection of imagery to revisit.
        </p>
      </div>
      <a
        href="/search"
        data-astro-prefetch
        class="inline-flex min-h-11 items-center rounded-lg bg-slate-950 px-4 text-sm font-bold text-white shadow-sm transition hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-100"
      >
        Find photos
      </a>
    </div>
    <div class="w-full">
      <FavoritesIsland client:only="react" />
    </div>
  </div>
</AppLayout>
