---
import AppLayout from '../layouts/AppLayout.astro';
import { FavoritesIsland } from '../components/islands/FavoritesIsland';
---

<AppLayout title="Favorites - Tasmania Aerial Photo Explorer">
  <div class="favorites-page">
    <div class="favorites-header">
      <h1 class="title">Saved Favorites</h1>
      <p class="subtitle">Your bookmarked aerial photos</p>
    </div>
    <div class="favorites-content">
      <FavoritesIsland client:only="react" />
    </div>
  </div>
</AppLayout>

<style>
  .favorites-page {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 1rem;
    color: inherit;
  }

  @media (min-width: 48em) {
    .favorites-page {
      padding-left: 2rem;
      padding-right: 2rem;
      max-width: 1200px;
    }
  }

  .favorites-header {
    margin-bottom: 2rem;
    padding-top: 1rem;
  }

  .title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .subtitle {
    opacity: 0.6;
  }

  .favorites-content {
    width: 100%;
  }
</style>
