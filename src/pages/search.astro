---
import AppLayout from '../layouts/AppLayout.astro';
import { SearchPageIsland } from '../components/islands/SearchPageIsland';
---

<AppLayout title="Search - Tasmania Aerial Photo Explorer">
  <SearchPageIsland client:only="react" />
</AppLayout>

<style is:global>
  /* Search page layout */
  .search-layout {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* Map fills the entire background */
  .search-map {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    overscroll-behavior: none;
    touch-action: none;
  }

  @media (min-width: 48em) {
    .search-map {
      left: var(--sidebar-width, 64px);
    }
  }

  .search-map .map-fill {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* Results panel */
  .search-panel {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overscroll-behavior: contain;
  }

  /* Mobile: stacked layout — map pinned at top, panel scrolls below */
  @media (max-width: 47.99em) {
    .search-layout {
      height: calc(100dvh - var(--mobile-nav-height, calc(64px + env(safe-area-inset-bottom))));
      min-height: 0;
    }

    .search-map {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      height: clamp(240px, 42dvh, 360px);
      min-height: 0;
      z-index: 0;
    }

    .search-panel {
      position: absolute;
      top: clamp(240px, 42dvh, 360px);
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 1;
      min-height: auto;
      overflow: hidden;
      background: #fff;
      border-top-left-radius: 22px;
      border-top-right-radius: 22px;
      box-shadow: 0 -14px 34px rgba(15, 23, 42, 0.12);
    }

    html[data-theme='dark'] .search-panel {
      background: #020617;
    }
  }

  /* Desktop: narrow glassmorphic panel */
  @media (min-width: 48em) {
    .search-panel {
      width: 420px;
      max-height: 100vh;
      max-height: 100dvh;
      overflow-y: auto;
      margin: 14px 0 14px 14px;
      border-radius: 26px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px) saturate(120%);
      -webkit-backdrop-filter: blur(16px) saturate(120%);
      border-right: 1px solid rgba(15, 23, 42, 0.08);
      box-shadow: 0 18px 48px rgba(15, 23, 42, 0.16);
    }

    html[data-theme='dark'] .search-panel {
      background: rgba(2, 6, 23, 0.88);
      border-right-color: rgba(255, 255, 255, 0.08);
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
    }
  }

  .search-panel-header {
    padding: 14px 14px 8px;
    position: sticky;
    top: 0;
    /* Above photo card badges; below portaled overlays (z-overlay / z-modal) */
    z-index: 20;
    background: inherit;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    overscroll-behavior: contain;
  }

  html[data-theme='dark'] .search-panel-header {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  /* Row that holds search input + filter toggle button side-by-side */
  .search-panel-bar {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-panel-bar > :first-child {
    flex: 1;
    min-width: 0;
  }

  /* Collapsible filter section (desktop only) */
  .search-panel-filters {
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    position: relative;
    z-index: 1;
  }

  html[data-theme='dark'] .search-panel-filters {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .search-panel-content {
    padding: 0 14px 16px;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    /* Isolate stacking context so photo card badges don't bleed above the header */
    isolation: isolate;
  }

  @media (min-width: 48em) {
    .search-panel-content {
      overflow: visible;
    }
  }
</style>
