---
import AppLayout from '../layouts/AppLayout.astro';
import { NavigationIsland } from '../components/islands/NavigationIsland';
import { MobileNavIsland } from '../components/islands/MobileNavIsland';
import { SearchPageIsland } from '../components/islands/SearchPageIsland';
---

<AppLayout title="Search - Tasmania Aerial Photo Explorer">
  <NavigationIsland client:only="react" />
  <SearchPageIsland client:only="react" />
  <MobileNavIsland client:only="react" />
</AppLayout>

<style is:global>
  /* Search page layout */
  .search-layout {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
  }

  /* Map fills the entire background */
  .search-map {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
  }

  @media (min-width: 48em) {
    .search-map {
      left: var(--sidebar-width, 64px);
    }
  }

  .search-map .map-fill {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* Results panel */
  .search-panel {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  /* Mobile: stacked layout */
  @media (max-width: 47.99em) {
    .search-layout {
      display: flex;
      flex-direction: column;
    }

    .search-map {
      position: relative;
      height: 40vh;
      min-height: 250px;
    }

    .search-panel {
      min-height: auto;
      flex: 1;
      background: var(--mantine-color-body, #fff);
    }
  }

  /* Desktop: narrow glassmorphic panel */
  @media (min-width: 48em) {
    .search-panel {
      width: 420px;
      max-height: 100vh;
      max-height: 100dvh;
      overflow-y: auto;
      margin: 14px 0 14px 14px;
      border-radius: 26px;
      background: linear-gradient(
        180deg,
        light-dark(rgba(255, 255, 255, 0.92), rgba(15, 23, 42, 0.92)),
        light-dark(rgba(255, 255, 255, 0.82), rgba(15, 23, 42, 0.84))
      );
      backdrop-filter: blur(24px) saturate(130%);
      -webkit-backdrop-filter: blur(24px) saturate(130%);
      border-right: 1px solid light-dark(rgba(0, 0, 0, 0.08), rgba(255, 255, 255, 0.08));
      box-shadow:
        0 24px 80px rgba(15, 23, 42, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.22);
    }
  }

  .search-panel-header {
    padding: 14px 14px 8px;
    position: sticky;
    top: 0;
    /* Must be above photo card badges (z-index 3) and below dropdown (z-index 200) */
    z-index: 100;
    background: inherit;
    border-bottom: 1px solid light-dark(rgba(15, 23, 42, 0.05), rgba(255, 255, 255, 0.08));
  }

  /* Row that holds search input + filter toggle button side-by-side */
  .search-panel-bar {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-panel-bar > :first-child {
    flex: 1;
    min-width: 0;
  }

  /* Collapsible filter section (desktop only) */
  .search-panel-filters {
    border-bottom: 1px solid light-dark(rgba(0, 0, 0, 0.06), rgba(255, 255, 255, 0.06));
    position: relative;
    z-index: 1;
  }

  .search-panel-content {
    padding: 0 14px 16px;
    flex: 1;
    /* Isolate stacking context so photo card badges don't bleed above the header */
    isolation: isolate;
  }
</style>
