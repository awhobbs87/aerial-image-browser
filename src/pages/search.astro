---
import AppLayout from '../layouts/AppLayout.astro';
import { NavigationIsland } from '../components/islands/NavigationIsland';
import { MobileNavIsland } from '../components/islands/MobileNavIsland';
import { SearchPageIsland } from '../components/islands/SearchPageIsland';
---

<AppLayout title="Search - Tasmania Aerial Photo Explorer">
  <NavigationIsland client:only="react" />
  <SearchPageIsland client:only="react" />
  <MobileNavIsland client:only="react" />
</AppLayout>

<style is:global>
  /* Search page layout */
  .search-layout {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
  }

  /* Map fills the entire background */
  .search-map {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
  }

  @media (min-width: 48em) {
    .search-map {
      left: var(--sidebar-width, 64px);
    }
  }

  .search-map .map-fill {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* Results panel */
  .search-panel {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  /* Mobile: stacked layout */
  @media (max-width: 47.99em) {
    .search-layout {
      display: flex;
      flex-direction: column;
    }

    .search-map {
      position: relative;
      height: 40vh;
      min-height: 250px;
    }

    .search-panel {
      min-height: auto;
      flex: 1;
      background: var(--mantine-color-body, #fff);
    }
  }

  /* Desktop: narrow glassmorphic panel */
  @media (min-width: 48em) {
    .search-panel {
      width: 420px;
      max-height: 100vh;
      max-height: 100dvh;
      overflow-y: auto;
      background: light-dark(rgba(255, 255, 255, 0.88), rgba(15, 23, 42, 0.88));
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-right: 1px solid light-dark(rgba(0, 0, 0, 0.08), rgba(255, 255, 255, 0.08));
    }
  }

  .search-panel-header {
    padding: 10px 12px 6px;
    position: sticky;
    top: 0;
    z-index: 2;
    background: inherit;
  }

  .search-panel-content {
    padding: 0 12px 12px;
    flex: 1;
  }
</style>
