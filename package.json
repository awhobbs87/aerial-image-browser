{
  "name": "tas-aerial-browser",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:tiff-tiles": "npm run dev --prefix services/tiff-tile-service",
    "build": "astro build",
    "preview": "astro preview",
    "start:tiff-tiles": "npm run start --prefix services/tiff-tile-service",
    "deploy:tiff-tiles": "npm run deploy --prefix services/tiff-tile-service",
    "deploy:tiff-tiles:dry-run": "npm run deploy:dry-run --prefix services/tiff-tile-service",
    "deploy": "astro build && wrangler deploy",
    "deploy:cloudflare": "pnpm run deploy:tiff-tiles && pnpm run deploy",
    "db:migrate": "wrangler d1 migrations apply PHOTOS_DB",
    "db:migrate:local": "wrangler d1 migrations apply PHOTOS_DB --local",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:theme": "vitest run --config vitest.config.ts tests/unit/lib/theme.test.ts && playwright test tests/e2e/theme.spec.ts",
    "test:watch": "vitest",
    "type-check": "astro check && tsc --noEmit",
    "lint": "pnpm run lint:ox && pnpm run lint:eslint",
    "lint:fix": "pnpm run lint:ox:fix && pnpm run lint:eslint:fix",
    "lint:ox": "oxlint .",
    "lint:ox:fix": "oxlint . --fix",
    "lint:eslint": "eslint 'src/**/*.{ts,tsx,astro}'",
    "lint:eslint:fix": "eslint 'src/**/*.{ts,tsx,astro}' --fix",
    "format": "pnpm run format:ox && pnpm run format:astro",
    "format:check": "pnpm run format:ox:check && pnpm run format:astro:check",
    "format:ox": "oxfmt --write src public package.json components.json astro.config.mjs eslint.config.js playwright.config.ts postcss.config.cjs tsconfig.json vitest.config.ts wrangler.jsonc",
    "format:ox:check": "oxfmt --check src public package.json components.json astro.config.mjs eslint.config.js playwright.config.ts postcss.config.cjs tsconfig.json vitest.config.ts wrangler.jsonc",
    "format:astro": "prettier --write 'src/**/*.astro'",
    "format:astro:check": "prettier --check 'src/**/*.astro'",
    "postinstall": "mkdir -p public/assets && cp node_modules/geotiff-tilesource/dist/assets/* public/assets/ 2>/dev/null || true",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/cloudflare": "^13.1.1",
    "@astrojs/react": "^5.0.0",
    "@cloudflare/kumo": "^2.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/dom": "^10.4.1",
    "astro": "^6.0.4",
    "clsx": "^2.1.1",
    "geotiff": "^2.1.3",
    "geotiff-tilesource": "^2.3.0",
    "maplibre-gl": "^5.20.1",
    "motion": "^13.2.0",
    "openseadragon": "^6.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "utif2": "^4.1.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.1.4",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.92.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --fix",
      "eslint --fix",
      "oxfmt --write"
    ],
    "src/**/*.{css,json}": [
      "oxfmt --write"
    ],
    "src/**/*.astro": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.24.0"
}
