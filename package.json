{
  "name": "tas-aerial-browser",
  "version": "4.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply PHOTOS_DB",
    "db:migrate:local": "wrangler d1 migrations apply PHOTOS_DB --local",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "type-check": "astro check && tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx,astro}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx,astro}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,astro,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,astro,css,json}'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/cloudflare": "^13.1.1",
    "@astrojs/react": "^5.0.0",
    "@mantine/core": "^8.3.17",
    "@mantine/form": "^8.3.17",
    "@mantine/hooks": "^8.3.17",
    "@mantine/notifications": "^8.3.17",
    "@tabler/icons-react": "^3.40.0",
    "@tanstack/react-query": "^5.90.21",
    "astro": "^6.0.4",
    "maplibre-gl": "^5.20.1",
    "openseadragon": "^6.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "utif2": "^4.1.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.1.4",
    "@cloudflare/workers-types": "^4.20260313.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.73.0"
  }
}
